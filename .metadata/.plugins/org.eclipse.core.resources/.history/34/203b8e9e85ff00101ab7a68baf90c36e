<!doctype html>
<html lang="en" xmlns:th="https://www.thymeleaf.com">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <title>Book Store</title>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f6f9;
        }

        .hero {
            background: linear-gradient(rgba(0,0,0,.6), rgba(0,0,0,.6)),
                        url('/images/bg.png') center/cover no-repeat;
            color: white;
            padding: 100px 20px;
            text-align: center;
        }

        .hero h1 {
            font-weight: 600;
        }

        .card img {
            height: 220px;
            object-fit: cover;
        }
		
		.btn-yellow {
		    background-color: #ffc107; /* yellow */
		    color: #000;               /* black text */
		    font-weight: 600;
		}

		.btn-yellow:hover {
		    background-color: #e6ac00; /* darker yellow on hover */
		    color: #000;
		}
		html, body {
			    height: 100%;
			    margin: 0;
			    display: flex;
			    flex-direction: column;
			}

			.page-container {
			    flex: 1;              /* Take up all remaining space */
			    display: flex;
			    flex-direction: column;
			}

			.content-wrap {
			    flex: 1;              /* Push footer to bottom if content is short */
			}

    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/"> Book Store</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="available_books">Available Books</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="my_books">My Books</a>
                </li>
            </ul>

            <a class="btn btn-warning fw-semibold" href="book_register">
                + New Book Register
            </a>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <h1>Welcome to the Book Store</h1>
    <p class="mt-3">
        Discover, manage, and enjoy your books 
    </p>
</section>
<div class="content-wrap">

<!-- AVAILABLE BOOKS (REAL DATA ONLY) -->
<div class="container my-5">
    <h2 class="text-center fw-bold mb-4"> Available Books</h2>

    <div class="row g-4">

        <!-- LOOP START -->
        <div class="col-md-4" th:each="b : ${book}">
            <div class="card shadow-sm h-100">

                <img th:src="@{'/' + ${b.imageName}}"
                     alt="Book Image"
                     class="card-img-top">

                <div class="card-body">
                    <h5 class="card-title" th:text="${b.name}"></h5>

                    <p class="text-muted">
                        Author: <span th:text="${b.author}"></span>
                    </p>

                    <p class="fw-bold">
                        Rs. <span th:text="${b.price}"></span>
                    </p>

                    <a th:href="@{/mylist/{id}(id=${b.id})}"
                       class="btn btn-yellow w-100">
                        Add to My Books
                    </a>
                </div>

            </div>
        </div>
        <!-- LOOP END -->

    </div>
</div>
</div>
<!-- FOOTER -->
<footer class="bg-dark text-white text-center py-3">
    © 2026 Book Store | All Rights Reserved
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
